{
  "name": "rad-pi",
  "version": "1.5.1",
  "type": "module",
  "description": "Default Radicle package for pi: core deterministic tooling",
  "keywords": [
    "pi-package",
    "radicle",
    "pi"
  ],
  "author": "Harry Hudson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanh/rad-pi.git"
  },
